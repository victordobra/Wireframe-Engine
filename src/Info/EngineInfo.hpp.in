#pragma once

/// @brief The engine's name.
#define WFE_ENGINE_NAME "@ENGINE_NAME@"

/// @brief The major component of the engine's version.
#define WFE_ENGINE_VERSION_MAJOR @ENGINE_VERSION_MAJOR@
/// @brief The minor component of the engine's version.
#define WFE_ENGINE_VERSION_MINOR @ENGINE_VERSION_MINOR@
/// @brief The patch component of the engine's version.
#define WFE_ENGINE_VERSION_PATCH @ENGINE_VERSION_PATCH@

/// @brief The size, in bytes, of a void pointer. Used to determine the architecture at compile time.
#define WFE_VOID_POINTER_SIZE @CMAKE_SIZEOF_VOID_P@